{
  "configurations": [
    {
      "name": "Remote-Linux",
      "includePath": [
        "${workspaceFolder}/**",
        "/usr/local/cuda/targets/x86_64-linux/include"
      ],
      "browse": {
        "path": [
          "/usr/local/cuda/targets/x86_64-linux/include"
        ],
        "limitSymbolsToIncludedHeaders": true
      },
      "compilerPath": "/usr/local/cuda/bin/nvcc",
      "intelliSenseMode": "linux-gcc-x64",
      "cppStandard": "c++17",
      "cStandard": "c11"
    }
  ],
  "version": 4
}
