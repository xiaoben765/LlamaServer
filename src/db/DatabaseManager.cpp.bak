void DatabaseManager::cleanupCache(int maxAgeHours) {
    std::lock_guard<std::mutex> lock(mutex_);
    
    if (!reconnect()) {
        return;
    }
    
    long cutoffTime = getCurrentTimestamp() - (maxAgeHours * 3600);
    
    std::stringstream ss;
    ss << "DELETE FROM llm_cache WHERE last_accessed < " << cutoffTime;
    
    executeQuery(ss.str());
}

std::vector<CacheRecord> DatabaseManager::getCacheStats(int limit) {
    std::lock_guard<std::mutex> lock(mutex_);
    std::vector<CacheRecord> records;
    
    if (!reconnect()) {
        return records;
    }
    
    std::stringstream ss;
    ss << "SELECT query_hash, query_text, response_text, created_at, hit_count, last_accessed "
       << "FROM llm_cache ORDER BY hit_count DESC LIMIT " << limit;
    
    MYSQL_RES* result = executeSelectQuery(ss.str());
    if (!result) {
        return records;
    }
    
    MYSQL_ROW row;
    while ((row = mysql_fetch_row(result))) {
        CacheRecord record;
        record.query_hash = row[0];
        record.query_text = row[1];
        record.response_text = row[2];
        record.created_at = atol(row[3]);
        record.hit_count = atoi(row[4]);
        record.last_accessed = atol(row[5]);
        records.push_back(record);
    }
    
    mysql_free_result(result);
    return records;
}

std::string DatabaseManager::getConfig(const std::string& key, const std::string& defaultValue) {
    std::lock_guard<std::mutex> lock(mutex_);
    
    if (!reconnect()) {
        return defaultValue;
    }
    
    std::stringstream ss;
    ss << "SELECT config_value FROM system_config WHERE config_key = '" << escapeString(key) << "'";
    
    MYSQL_RES* result = executeSelectQuery(ss.str());
    if (!result) {
        return defaultValue;
    }
    
    MYSQL_ROW row = mysql_fetch_row(result);
    std::string value = row ? row[0] : defaultValue;
    
    mysql_free_result(result);
    return value;
}

bool DatabaseManager::setConfig(const std::string& key, const std::string& value) {
    std::lock_guard<std::mutex> lock(mutex_);
    
    if (!reconnect()) {
        return false;
    }
    
    // 先检查是否存在
    std::stringstream checkSS;
    checkSS << "SELECT COUNT(*) FROM system_config WHERE config_key = '" << escapeString(key) << "'";
    
    MYSQL_RES* result = executeSelectQuery(checkSS.str());
    if (!result) {
        return false;
    }
    
    MYSQL_ROW row = mysql_fetch_row(result);
    bool exists = row && atoi(row[0]) > 0;
    mysql_free_result(result);
    
    std::stringstream ss;
    if (exists) {
        ss << "UPDATE system_config SET config_value = '" << escapeString(value) 
           << "', last_updated = " << getCurrentTimestamp()
           << " WHERE config_key = '" << escapeString(key) << "'";
    } else {
        ss << "INSERT INTO system_config (config_key, config_value, created_at, last_updated) VALUES ("
           << "'" << escapeString(key) << "', "
           << "'" << escapeString(value) << "', "
           << getCurrentTimestamp() << ", "
           << getCurrentTimestamp() << ")";
    }
    
    return executeQuery(ss.str());
}

std::vector<std::pair<std::string, std::string>> DatabaseManager::getAllConfigs() {
    std::lock_guard<std::mutex> lock(mutex_);
    std::vector<std::pair<std::string, std::string>> configs;
    
    if (!reconnect()) {
        return configs;
    }
    
    const char* query = "SELECT config_key, config_value FROM system_config";
    MYSQL_RES* result = executeSelectQuery(query);
    if (!result) {
        return configs;
    }
    
    MYSQL_ROW row;
    while ((row = mysql_fetch_row(result))) {
        configs.emplace_back(row[0], row[1]);
    }
    
    mysql_free_result(result);
    return configs;
}

json DatabaseManager::getSystemStats() {
    std::lock_guard<std::mutex> lock(mutex_);
    json stats;
    
    if (!reconnect()) {
        return stats;
    }
    
    stats["users_count"] = getUserCount();
    stats["sessions_count"] = getSessionCount();
    stats["messages_count"] = getMessageCount();
    stats["cache_count"] = getCacheCount();
    stats["uptime"] = getCurrentTimestamp();
    
    // 添加数据库状态信息
    stats["database"] = {
        {"status", "connected"},
        {"server", config_.host + ":" + std::to_string(config_.port)},
        {"name", config_.dbname}
    };
    
    return stats;
}

