# 性能测试工具构建配置

CXX = g++
CXXFLAGS = -std=c++17 -Wall -Wextra -O2 -pthread
INCLUDES = -I./include
LIBS = -lcurl -ljsoncpp -lpthread

# 目标文件
PERFORMANCE_TARGET = bin/performance_tester

# 源文件
PERFORMANCE_SOURCES = src/performance_tester.cpp

# 构建性能测试工具
$(PERFORMANCE_TARGET): $(PERFORMANCE_SOURCES)
	@mkdir -p bin
	$(CXX) $(CXXFLAGS) $(INCLUDES) -o $@ $^ $(LIBS)
	@echo "性能测试工具构建完成: $@"

# 安装依赖
install-deps:
	@echo "安装性能测试依赖..."
	sudo apt-get update
	sudo apt-get install -y apache2-utils wrk libcurl4-openssl-dev libjsoncpp-dev sysstat htop

# 运行快速性能测试
test-quick: $(PERFORMANCE_TARGET)
	@echo "运行快速性能测试..."
	./performance_test.sh --quick

# 运行完整性能测试
test-full: $(PERFORMANCE_TARGET)
	@echo "运行完整性能测试..."
	./performance_test.sh

# 运行压力测试
test-stress: $(PERFORMANCE_TARGET)
	@echo "运行压力测试..."
	./performance_test.sh --stress

# 运行自定义性能测试工具
test-custom: $(PERFORMANCE_TARGET)
	@echo "运行自定义性能测试工具..."
	./$(PERFORMANCE_TARGET)

# 清理
clean-perf:
	rm -f $(PERFORMANCE_TARGET)
	rm -rf performance_results/

.PHONY: install-deps test-quick test-full test-stress test-custom clean-perf
